<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Cache-Control" content="no-store">
  <title>Pay</title>
  <style>
    html, body { margin: 0; background: #fff; color: #111; font-family: sans-serif; }
    body { padding: 32px 20px; text-align: center; }
    h1 { font-size: 22px; }
    .addr { word-break: break-all; color: #444; margin: 16px 0; font-size: 14px; }
    a.pay {
      display: block;
      margin: 12px auto 0;
      max-width: 320px;
      padding: 18px 24px;
      background: #0500ff;
      color: #fff;
      text-decoration: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 18px;
    }
  </style>
</head>
<body>
  <h1>Pay USDT</h1>
  <p>Tap the button if Send does not open.</p>
  <p class="addr"><%= qr.pay_address %></p>
  <a class="pay" id="payBtn" href="<%= nativeSend %>">Pay USDT</a>
  <script>
    var nextScan = <%- JSON.stringify(nextScan) %>;
    window.addEventListener('pageshow', function (ev) {
      if (ev.persisted) location.replace(nextScan);
    });
    var hiddenAt = 0;
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') {
        hiddenAt = Date.now();
        return;
      }
      if (hiddenAt && Date.now() - hiddenAt > 2000) location.replace(nextScan);
    });
    setTimeout(function () {
      window.location.href = <%- JSON.stringify(nativeSend) %>;
    }, 600);
  </script>
</body>
</html>
