<%- include('partials/head') %>
<div class="login-shell">
  <div class="login-panel">
    <div class="login-copy">
      <p class="eyebrow">Stable QR · Live destinations</p>
      <h1>Codes that never change.<br>Destinations that do.</h1>
      <p>Every printed QR encodes only <code><%= settings.website_url %>/r/{code}</code>. Your dashboard decides where scanners land.</p>
    </div>
    <form id="loginForm" class="login-card" novalidate>
      <h2>Sign in</h2>
      <p class="text-muted">JWT session · bcrypt passwords</p>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" id="email" name="email" type="email" required autocomplete="username">
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" required autocomplete="current-password">
      </div>
      <div class="alert alert-danger d-none" id="loginError"></div>
      <button class="btn btn-brand w-100" type="submit">Continue</button>
    </form>
  </div>
</div>
<script src="/public/js/theme.js"></script>
<script src="/public/js/api.js"></script>
<script src="/public/js/login.js"></script>
</body>
</html>
