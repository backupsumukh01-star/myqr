  "description": "Production-ready Dynamic QR Code Management System. QR images encode a stable short URL; destinations are resolved at scan time.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/database/seed.js",
